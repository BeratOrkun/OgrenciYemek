# ÖğrenciYemek — Hostinger (Apache/LiteSpeed) yapılandırması
# Site kökü: https://ogrenciyemek.com/

# ----------------------------------------------------------
# 1) HTTPS ve www yönlendirmeleri
#    PWA kurulumu yalnızca HTTPS'te çalışır.
# ----------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # http -> https
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # www -> kök alan adı (tek kanonik adres)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ----------------------------------------------------------
# 2) MIME tipleri
# ----------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/manifest+json  .webmanifest
    AddType application/javascript     .js
    AddType image/svg+xml              .svg
    AddType image/png                  .png
</IfModule>

# manifest.json doğru tiple servis edilsin
<Files "manifest.json">
    <IfModule mod_headers.c>
        Header set Content-Type "application/manifest+json; charset=utf-8"
    </IfModule>
</Files>

# ----------------------------------------------------------
# 3) Önbellekleme
#    sw.js ve HTML asla uzun süre önbelleğe alınmamalı; yoksa
#    kullanıcılar eski sürümde takılı kalır.
# ----------------------------------------------------------
<IfModule mod_headers.c>
    # Service worker — her zaman ağdan doğrula
    <Files "sw.js">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </Files>

    # Manifest — kısa ömür
    <Files "manifest.json">
        Header set Cache-Control "public, max-age=3600"
    </Files>

    # HTML — her zaman taze
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    # CSS/JS — sürümsüz dosya adları olduğu için kısa ömür + revalidate
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

    # İkonlar — nadiren değişir
    <FilesMatch "\.(png|svg|ico|webp)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Güvenlik başlıkları
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ----------------------------------------------------------
# 4) Sıkıştırma
# ----------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
</IfModule>

# ----------------------------------------------------------
# 5) Dizin listelemesini kapat
# ----------------------------------------------------------
Options -Indexes

# ----------------------------------------------------------
# 6) Varsayılan belge
# ----------------------------------------------------------
DirectoryIndex index.html
