# ÖğrenciYemek — Hostinger (Apache/LiteSpeed) yapılandırması
# Site kökü: https://ogrenciyemek.com/

# ----------------------------------------------------------
# 1) HTTPS ve www yönlendirmeleri
#    PWA kurulumu yalnızca HTTPS'te çalışır.
# ----------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # http -> https
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # www -> kök alan adı (tek kanonik adres)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ----------------------------------------------------------
# 2) MIME tipleri
# ----------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/manifest+json  .webmanifest
    AddType application/javascript     .js
    AddType image/svg+xml              .svg
    AddType image/png                  .png
</IfModule>

# manifest.json doğru tiple servis edilsin
<Files "manifest.json">
    <IfModule mod_headers.c>
        Header set Content-Type "application/manifest+json; charset=utf-8"
    </IfModule>
</Files>

# ----------------------------------------------------------
# 3) Önbellekleme
#    sw.js ve HTML asla uzun süre önbelleğe alınmamalı; yoksa
#    kullanıcılar eski sürümde takılı kalır.
# ----------------------------------------------------------
<IfModule mod_headers.c>
    # Service worker — her zaman ağdan doğrula
    <Files "sw.js">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </Files>

    # Manifest — her zaman taze
    <Files "manifest.json">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </Files>

    # HTML — her zaman taze
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    # CSS/JS — kısa ömür + revalidate.
    # sw.js HARİÇ: bu kalıp onu da yakalıyordu ve Apache FilesMatch'i
    # Files'tan sonra işlediği için yukarıdaki max-age=0 kuralını
    # eziyordu. Sonuç: service worker güncellemeleri 1 saate kadar
    # gecikiyor, kullanıcılar eski sürümde kalıyordu.
    <FilesMatch "^(?!sw\.js$).+\.(css|js)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

    # İkonlar — nadiren değişir
    <FilesMatch "\.(png|svg|ico|webp)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Güvenlik başlıkları
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ----------------------------------------------------------
# 4) Sıkıştırma
# ----------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
</IfModule>

# ----------------------------------------------------------
# 5) Dizin listelemesini kapat
# ----------------------------------------------------------
Options -Indexes

# ----------------------------------------------------------
# 6) Varsayılan belge ve 404 sayfası
#    /kyk-yemek-listesi/ankara/ gibi SEO sayfaları klasör/index.html olarak durur.
# ----------------------------------------------------------
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ----------------------------------------------------------
# 7) Yalnızca geliştirme amaçlı klasörleri dışarıya kapat
#    (sayfa üreticisi, GitHub iş akışları). Ziyaretçi 404 görür.
# ----------------------------------------------------------
<IfModule mod_alias.c>
    RedirectMatch 404 ^/(tools|\.github|instagram-posts)(/|$)

    # Kısa ve akılda kalır adresler (Instagram biyografisi, paylaşım) → asıl sayfa
    RedirectMatch 301 ^/(kyk|kyk-menu|kyk-yemek|kyk-yemekleri|kyk-yemek-menusu|kyk-menusu)/?$ /kyk-yemek-listesi/
    RedirectMatch 301 ^/(ankara-kyk|kyk-ankara|ankara-kyk-yemek|ankara-kyk-menu|ankara-kyk-yemek-listesi)/?$ /kyk-yemek-listesi/ankara/
    # /kyk/sivas → /kyk-yemek-listesi/sivas/ (yalnızca küçük harf il adları)
    RedirectMatch 301 ^/kyk/([a-z]+)/?$ /kyk-yemek-listesi/$1/
    RedirectMatch 301 ^/(gazi|gazi-yemek|gazi-yemek-listesi|gazi-yemekhane)/?$ /gazi-universitesi-yemek-listesi/
    RedirectMatch 301 ^/(hacettepe|hacettepe-yemek|hacettepe-yemekhane)/?$ /hacettepe-yemek-listesi/
    RedirectMatch 301 ^/(anku|ankara-universitesi|ankara-universitesi-yemek)/?$ /ankara-universitesi-yemek-listesi/
    RedirectMatch 301 ^/(genclik|genclik-sofrasi-menu)/?$ /genclik-sofrasi/
    RedirectMatch 301 ^/(ucretsiz-yemek|ankara-ucretsiz-yemek)/?$ /ankara-ogrenci-ucretsiz-yemek/
    RedirectMatch 301 ^/(universiteler|universite-yemek-listeleri)/?$ /ankara-universite-yemek-listeleri/
</IfModule>
